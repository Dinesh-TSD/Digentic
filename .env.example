# NextAuth.js v5 Configuration
# Generate a secret: npx auth secret or openssl rand -base64 32
AUTH_SECRET=changeme_in_production_generate_random_secret_here
NEXTAUTH_URL=http://localhost:3000

# MongoDB Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/digentic?retryWrites=true&w=majority

# OAuth Providers
# Google OAuth: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email Reset Provider (SMTP / Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DIGENTIC TECH" <noreply@digentic.tech>

# Temporary Admin Credentials (Development / Demo)
TEMP_ADMIN_EMAIL=admin@digentic.tech
TEMP_ADMIN_PASSWORD=admin123

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
